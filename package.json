{
  "name": "@larkwire/desktop",
  "version": "0.1.0",
  "description": "灵鹊 Larkwire 桌面壳（Electron）——双皮一份逻辑：桥核心 import 自 larkwire 包，CLI 与桌面共用",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron . --larkwire-desktop",
    "start": "electron . --larkwire-desktop",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "dist": "node scripts/build.mjs && electron-builder && touch release/.metadata_never_index"
  },
  "dependencies": {
    "larkwire": "^0.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@larkwire/protocol": "^0.1.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.7.0",
    "@types/qrcode": "^1.5.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.20.2",
    "typescript": "^5.6.0"
  }
}
